# Netlify response headers — jikan.moe
# Reference: https://docs.netlify.com/routing/headers/

# Content-hashed build output: safe to cache forever.
/_app/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker is deliberately NOT fingerprinted, so it must never be
# long-cached or clients would be stuck on a stale worker indefinitely.
/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprint-free static assets: revalidate weekly.
/favicon/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
